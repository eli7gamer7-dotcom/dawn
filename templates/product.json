{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartilhar"
          }
        },
        "lumora_tools": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'lumora-product-tools', product: product %}"
          }
        },
        "care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composição e cuidados",
            "icon": "none",
            "content": "<p>Consulte a composição na descrição do produto e siga as instruções da etiqueta. Precisa de informações sobre a peça? Fale com a nossa equipe antes de comprar.</p>"
          }
        },
        "shipping": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"lm-product-tools\"><button type=\"button\" class=\"lm-text-link\" data-lm-open=\"lm-help\">{% render 'lumora-icon', name: 'return' %} Entrega, trocas e devoluções</button><button type=\"button\" class=\"lm-text-link\" data-lm-open=\"lm-contact\">{% render 'lumora-icon', name: 'support' %} Fale com a gente</button></div>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "lumora_tools",
        "quantity_selector",
        "buy_buttons",
        "description",
        "care",
        "shipping",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "COMBINE COM SEU MOVIMENTO",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
