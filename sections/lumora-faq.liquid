<section id="lm-faq" class="lm-section lm-container lm-faq" aria-labelledby="lm-faq-title-{{ section.id }}">
  <div class="lm-faq-intro"><p class="lm-eyebrow">PODE PERGUNTAR</p><h2 id="lm-faq-title-{{ section.id }}">{{ section.settings.title | escape }}</h2><p>Queremos que você se sinta bem em cada etapa da compra.</p><button class="lm-text-link" type="button" data-lm-open="lm-contact">Fale com a gente {% render 'lumora-icon', name: 'arrow' %}</button></div>
  <div class="lm-faq-items">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div>
</section>
{% schema %}
{"name":"Lumora · Dúvidas","settings":[{"type":"text","id":"title","label":"Título","default":"ANTES DO PRÓXIMO MOVIMENTO."}],"blocks":[{"type":"question","name":"Pergunta","settings":[{"type":"text","id":"question","label":"Pergunta","default":"Como escolher meu tamanho?"},{"type":"richtext","id":"answer","label":"Resposta","default":"<p>Consulte o guia de tamanhos e as informações da peça. Se ainda tiver dúvidas, entre em contato antes de comprar.</p>"}]}],"presets":[{"name":"Lumora · Dúvidas","blocks":[{"type":"question","settings":{"question":"Como escolher meu tamanho?","answer":"<p>Use o guia de tamanhos disponível na página do produto. Compare suas medidas com as informações da peça. Se a tabela ainda não estiver disponível, fale com a nossa equipe para confirmar antes de comprar.</p>"}},{"type":"question","settings":{"question":"Como consultar o frete e o prazo de entrega?","answer":"<p>O frete e a previsão de entrega são apresentados no checkout, de acordo com seu endereço e os serviços disponíveis para o pedido.</p>"}},{"type":"question","settings":{"question":"Quais formas de pagamento posso usar?","answer":"<p>As opções disponíveis para a sua compra aparecem no checkout. Confira as condições e eventuais possibilidades de parcelamento antes de finalizar.</p>"}},{"type":"question","settings":{"question":"Como funcionam as trocas e devoluções?","answer":"<p>Consulte a política de trocas e devoluções da loja. Para solicitar atendimento sobre um pedido, envie seu número de pedido pelo formulário de contato.</p>"}},{"type":"question","settings":{"question":"Como cuidar das minhas peças?","answer":"<p>Siga sempre a etiqueta de composição e lavagem de cada produto. Ela contém as orientações adequadas para o tecido da sua peça.</p>"}},{"type":"question","settings":{"question":"Como acompanho meu pedido?","answer":"<p>Use o link de acompanhamento enviado pela loja ao seu e-mail. Se você tem uma conta, também pode consultar seus pedidos por ela. Caso precise de ajuda, fale com a nossa equipe.</p>"}}]}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}