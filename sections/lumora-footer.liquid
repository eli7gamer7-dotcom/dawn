<footer class="lm-footer">
  <div class="lm-container lm-footer-grid">
    <div class="lm-footer-brand"><a href="{{ routes.root_url }}" class="lm-brand">{% render 'lumora-brand' %}</a><p>Mais movimento.<br>Mais você.</p><div class="lm-socials">{% if settings.social_instagram_link != blank %}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram da loja">Instagram ↗</a>{% endif %}{% if settings.social_tiktok_link != blank %}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok ↗</a>{% endif %}</div></div>
    <div><h2>EXPLORE</h2><a href="{{ routes.all_products_collection_url }}">Todas as peças</a><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">Novidades</a><a href="{{ routes.root_url }}#lm-collections">Coleções</a><button type="button" data-lm-open="lm-wishlist" hidden data-lm-js>Meus favoritos</button></div>
    <div><h2>A LUMORA</h2><a href="{{ routes.root_url }}#lm-about">Nossa essência</a><button type="button" data-lm-open="lm-size-guide">Guia de tamanhos</button><button type="button" data-lm-open="lm-care">Cuidados com as peças</button>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Minha conta e pedidos</a>{% endif %}</div>
    <div><h2>PRECISA DE AJUDA?</h2><a href="{{ routes.root_url }}#lm-faq">Perguntas frequentes</a><button type="button" data-lm-open="lm-help">Entrega, trocas e devoluções</button>{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div>
    <div><h2>VAMOS CONVERSAR</h2><button class="lm-contact-link" type="button" data-lm-open="lm-contact">{% render 'lumora-icon', name: 'mail' %} Fale com a gente</button>{% if settings.lumora_contact_email != blank %}<a href="mailto:{{ settings.lumora_contact_email | escape }}">{{ settings.lumora_contact_email | escape }}</a>{% endif %}{% if settings.lumora_whatsapp != blank %}<a href="https://wa.me/{{ settings.lumora_whatsapp | remove: ' ' | remove: '+' | remove: '(' | remove: ')' | remove: '-' | escape }}" target="_blank" rel="noopener">Atendimento pelo WhatsApp ↗</a>{% endif %}{% if shop.enabled_payment_types.size > 0 %}<ul class="lm-payment-list" aria-label="Formas de pagamento">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{% endfor %}</ul>{% endif %}</div>
  </div>
  <div class="lm-container lm-footer-bottom"><small>© {{ 'now' | date: '%Y' }} {{ settings.lumora_brand_name | default: 'Lumora' | escape }}. Todos os direitos reservados.{% if settings.lumora_business_details != blank %}<br>{{ settings.lumora_business_details | escape }}{% endif %}</small><span>Move better. Feel stronger.</span></div>
</footer>
{% schema %}
{"name":"Lumora · Rodapé","settings":[],"enabled_on":{"groups":["footer"]}}
{% endschema %}