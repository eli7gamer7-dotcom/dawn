{% liquid
  assign brand_name = settings.lumora_brand_name | default: 'Musa'
  assign brand_tagline = settings.lumora_brand_tagline | default: 'FITNESS'
%}
<img class="lm-musa-symbol" src="{{ 'musa-fitness-symbol.png' | asset_url }}" width="1792" height="896" alt="" aria-hidden="true" loading="eager">
<span class="lm-brand-word lm-musa-word">{{ brand_name | escape }}<small>{{ brand_tagline | escape }}</small></span>
